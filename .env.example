# Copy to .env and fill in secrets.
RAG_API_KEYS=replace-with-a-long-random-service-key
COHERE_API_KEY=replace-with-your-cohere-api-key
COHERE_MODEL=command-r-08-2024
RAG_RETRIEVER=pgvector
PGVECTOR_DSN=postgresql://rag:rag@localhost:55432/rag
REDIS_URL=redis://localhost:6379/0
RAG_LLM_PROVIDER=cohere
RAG_SEMANTIC_CACHE=0
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_ADMIN_KEY=replace-me
AZURE_SEARCH_INDEX=regulatory-rag
AZURE_FOUNDRY_ENDPOINT=https://your-foundry.openai.azure.com
AZURE_FOUNDRY_API_KEY=replace-me
AZURE_FOUNDRY_DEPLOYMENT=your-chat-deployment
